{
  "name": "intellegode",
  "displayName": "intellegode",
  "description": "Fight vibe coding. Understand your own code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "intellegode.quizMe",
        "title": "Intellegode: Quiz Me"
      }
    ],
    "keybindings": [
      {
        "command": "intellegode.quizMe",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q",
        "when": "editorFocus && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Intellegode",
      "properties": {
        "intellegode.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for the Ollama server (without /api path)."
        },
        "intellegode.defaultModel": {
          "type": "string",
          "default": "qwen3.5:4b",
          "description": "Default Ollama model used for Intellegode requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node -r ./scripts/structuredClonePolyfill.cjs ./node_modules/@vscode/test-cli/out/bin.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
